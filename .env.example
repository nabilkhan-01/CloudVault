# AWS resource configuration (not credentials)
AWS_REGION=ap-south-1
S3_BUCKET=replace-with-your-private-bucket-name

# Optional local application login
APP_USERNAME=replace-with-your-username
APP_PASSWORD=replace-with-your-password
SESSION_SECRET=replace-with-a-long-random-secret

# Upload limit in MB
MAX_UPLOAD_MB=10
