{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudVaultBucketList",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::REPLACE_WITH_YOUR_BUCKET",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["uploads/", "uploads/*"]
        }
      }
    },
    {
      "Sid": "CloudVaultObjectAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::REPLACE_WITH_YOUR_BUCKET/uploads/*"
    }
  ]
}
